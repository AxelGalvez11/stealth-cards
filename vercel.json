{
  "buildCommand": "node design/to-web.mjs",
  "outputDirectory": "web",
  "functions": { "api/index.js": { "maxDuration": 60 } },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/mcp", "destination": "/api/index" },
    { "source": "/media/:path*", "destination": "/api/index" },
    { "source": "/((?!.*\\.).*)", "destination": "/index.html" }
  ]
}
